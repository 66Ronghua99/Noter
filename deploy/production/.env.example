# Compose interpolation and the non-secret server configuration contract.
NOTER_API_IMAGE=ghcr.io/example/noter-api:0000000000000000000000000000000000000000
NOTER_ENV_FILE=/opt/noter/.env
NOTER_API_DOMAIN=alarms.example.com

# Keep this file secret on the production host. These values are placeholders only.
NOTER_CLIENT_TOKEN=replace-with-a-random-client-token
CHAT_UPSTREAM_URL=https://chat.example.com/v1
CHAT_UPSTREAM_API_KEY=replace-with-chat-upstream-key
CHAT_UPSTREAM_MODEL=replace-with-chat-model
ASR_UPSTREAM_URL=https://asr.example.com/v1
ASR_UPSTREAM_API_KEY=replace-with-asr-upstream-key
ASR_UPSTREAM_MODEL=replace-with-asr-model

CHAT_MAX_OUTPUT_TOKENS=512
CHAT_UPSTREAM_TIMEOUT_MS=60000
ASR_UPSTREAM_TIMEOUT_MS=60000
CHAT_RATE_LIMIT_PER_MINUTE=30
ASR_RATE_LIMIT_PER_MINUTE=10
CHAT_MAX_CONCURRENCY=8
ASR_MAX_CONCURRENCY=4
NOTER_LOG_LEVEL=info
